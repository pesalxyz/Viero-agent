# Secrets: install as /etc/viero/viero.env with mode 0640, root:viero.
VIERO_GMGN_BIN=gmgn-cli
# Set to 1 to make preflight skip the GMGN_API_KEY check and every
# per-chain authenticated GMGN trending call. The Telegram unit sets
# this unconditionally. Discovery loops use it as a hard gate.
VIERO_SKIP_GMGN_PREFLIGHT=0

# Runtime state. The systemd unit grants write access only to this directory.
VIERO_DATA_DIR=/var/lib/viero
VIERO_CHAINS=4663,56,8453,5042
VIERO_TOKEN_LIMIT=3
VIERO_POOL_LIMIT=10
VIERO_CONFIG=config/viero.paper.json
VIERO_MODE=watch
VIERO_EXECUTION_ENABLED=false
VIERO_SIGNER_SOCKET=/run/viero-signer/viero.sock

# ── LLM-assisted analysis (optional but recommended) ─────────
VIERO_LLM_ENABLED=true
VIERO_LLM_BASE_URL=
VIERO_LLM_API_KEY=
VIERO_LLM_MODEL=openai/gpt-4o-mini
# Per-role overrides (optional):
# VIERO_LLM_MODEL_SCREENER=openai/gpt-4o
# VIERO_LLM_MODEL_MANAGER=anthropic/claude-3-5-sonnet
# VIERO_LLM_MODEL_GENERAL=openai/gpt-4o-mini
VIERO_LLM_TEMPERATURE=0.2
VIERO_LLM_MAX_TOKENS=1024
VIERO_LLM_TIMEOUT_MS=90000

# Telegram operator bot. TELEGRAM_USER_IDS is a comma-separated allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# Required comma-separated RPC fallback lists for enabled chains.
VIERO_RPC_4663=
VIERO_RPC_56=
VIERO_RPC_8453=
VIERO_RPC_5042=

# Complete screening is intentionally not part of this deployment layer.
VIERO_INDEXER_DISABLE=1
VIERO_INDEXER_4663=
VIERO_INDEXER_56=
VIERO_INDEXER_8453=
VIERO_INDEXER_5042=

# Built-in normalized protocol indexer (deployment start blocks verified 2026-09-18).
VIERO_INDEXER_HOST=127.0.0.1
VIERO_INDEXER_PORT=9100
VIERO_INDEXER_DATA_DIR=/var/lib/viero/indexer
VIERO_INDEXER_START_4663=8930
VIERO_INDEXER_START_56=26324014
VIERO_INDEXER_START_8453=1371680
VIERO_INDEXER_START_5042=1948019

# Keep credential placeholders empty.
GMGN_API_KEY=

# Never add PRIVATE_KEY, MNEMONIC, EVM_PRIVATE_KEY, EVM_MNEMONIC, VIERO_PRIVATE_KEY, or VIERO_MNEMONIC.
