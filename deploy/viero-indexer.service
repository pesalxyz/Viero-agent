[Unit]
Description=Viero normalized EVM protocol indexer
Documentation=file:/opt/viero/current/docs/viero-indexer.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=viero
Group=viero
WorkingDirectory=/opt/viero/current
Environment=NODE_ENV=production
Environment=HOME=/var/lib/viero
EnvironmentFile=/etc/viero/viero.env
ExecStart=/usr/bin/node build/viero/indexer-server.js
Restart=on-failure
RestartSec=15
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/viero
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

StateDirectory=viero
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viero-indexer

[Install]
WantedBy=multi-user.target
