[Unit]
Description=Viero isolated EVM transaction signer
Documentation=file:/opt/viero/current/docs/execution.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=viero-signer
Group=viero
WorkingDirectory=/opt/viero/current
Environment=NODE_ENV=production
Environment=HOME=/var/lib/viero-signer
EnvironmentFile=/etc/viero/viero.env
EnvironmentFile=/etc/viero/signer.env
ExecStart=/usr/bin/node build/viero/signer-server.js
Restart=on-failure
RestartSec=15
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0007

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/viero-signer
ReadWritePaths=/var/lib/viero-signer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

RuntimeDirectory=viero-signer
RuntimeDirectoryMode=0750
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viero-signer

[Install]
WantedBy=multi-user.target
