[Unit]
Description=Viero EVM screening and autonomous LP agent
Documentation=file:/opt/viero/current/docs/deployment.md
# Token-first targeted RPC enrichment is the runtime path. The full
# chain indexer is OPTIONAL and may be started independently — the
# agent does not require it.
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=viero
Group=viero
WorkingDirectory=/opt/viero/current
Environment=NODE_ENV=production
Environment=HOME=/var/lib/viero
EnvironmentFile=/etc/viero/viero.env
ExecStartPre=/opt/viero/current/deploy/run-agent.sh preflight
ExecStart=/opt/viero/current/deploy/run-agent.sh
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/viero
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

StateDirectory=viero
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=viero-agent

[Install]
WantedBy=multi-user.target
