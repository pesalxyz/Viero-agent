# Install separately as /etc/viero/signer.env with owner root:viero-signer and mode 0640.
VIERO_EXECUTION_ENABLED=false
VIERO_SIGNER_PRIVATE_KEY=
VIERO_SIGNER_SOCKET=/run/viero-signer/viero.sock
VIERO_SIGNER_TX_JOURNAL=/var/lib/viero-signer/transactions.jsonl
VIERO_EVIDENCE_CACHE_FILE=/var/lib/viero-signer/evidence-cache.json
RELAY_API_KEY=
VIERO_SIGNER_RELAY_OPERATION_STORE=/var/lib/viero-signer/relay-operations.db
VIERO_EVIDENCE_SIGNING_PRIVATE_KEY_FILE=/etc/viero/evidence-signing-private.pem
