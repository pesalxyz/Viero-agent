# Copy to .env and fill in your own values. Never commit .env.

# Discovery
VIERO_GMGN_BIN=gmgn-cli

# Required RPC endpoints for enabled chains. Comma-separated fallbacks are supported.
VIERO_RPC_4663=
VIERO_RPC_56=
VIERO_RPC_8453=
VIERO_RPC_5042=

# Runtime
VIERO_CHAINS=4663
VIERO_TOKEN_LIMIT=50
VIERO_POOL_LIMIT=10
VIERO_CONFIG=config/viero.paper.json
VIERO_MODE=watch
VIERO_DATA_DIR=data/viero
VIERO_TOKEN_MEMORY_PATH=data/viero/token-memory.json
VIERO_BLOCKED_TOKENS_PATH=data/viero/blocked-tokens.json
VIERO_SKIP_GMGN_PREFLIGHT=0

# Optional PostgreSQL persistence
DATABASE_URL=
TEST_DATABASE_URL=

# Telegram operator interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# Agent-to-signer connection. Keep execution disabled until fully reviewed.
VIERO_EXECUTION_ENABLED=false
VIERO_SIGNER_SOCKET=/run/viero-signer/viero.sock

# Signer-only secrets. For systemd, place these in /etc/viero/signer.env,
# not /etc/viero/viero.env.
VIERO_SIGNER_PRIVATE_KEY=
VIERO_SIGNER_TX_JOURNAL=/var/lib/viero-signer/transactions.jsonl
RELAY_API_KEY=

# Optional LLM analysis
VIERO_LLM_ENABLED=false
VIERO_LLM_BASE_URL=
VIERO_LLM_API_KEY=
VIERO_LLM_MODEL=
VIERO_LLM_MODEL_SCREENER=
VIERO_LLM_MODEL_MANAGER=
VIERO_LLM_MODEL_GENERAL=
VIERO_LLM_TEMPERATURE=0.2
VIERO_LLM_MAX_TOKENS=1024
VIERO_LLM_TIMEOUT_MS=90000

# Optional legacy development indexer. Production installer keeps it disabled.
VIERO_INDEXER_DISABLE=1
VIERO_INDEXER_HOST=127.0.0.1
VIERO_INDEXER_PORT=9100
VIERO_INDEXER_DATA_DIR=data/viero-indexer
VIERO_INDEXER_4663=
VIERO_INDEXER_56=
VIERO_INDEXER_8453=
VIERO_INDEXER_5042=
VIERO_INDEXER_START_4663=
VIERO_INDEXER_START_56=
VIERO_INDEXER_START_8453=
VIERO_INDEXER_START_5042=

# Keep credential placeholders empty.
GMGN_API_KEY=
