# Copy to .env and fill only the values needed for your setup.
# Never commit .env, wallet keys, API keys, or runtime state.

# ── 1. REQUIRED: Robinhood Chain deterministic operation ────────────────
# GMGN credential used by Hot Search and token security screening.
GMGN_API_KEY=
# One or more comma-separated HTTPS RPC URLs for Robinhood Chain.
VIERO_RPC_4663=
# Safe defaults: Robinhood only, read-only/watch mode, no live writes.
VIERO_CHAINS=4663
VIERO_MODE=watch
VIERO_EXECUTION_ENABLED=false

# ── 2. LIVE EXECUTION: signer-only values ───────────────────────────────
# Keep these in /etc/viero/signer.env on a VPS, not in the agent .env.
# Enable only after reviewing strategy, wallet balances, and simulations.
VIERO_SIGNER_PRIVATE_KEY=

# ── 3. OPTIONAL FEATURES ───────────────────────────────────────────────
# Telegram operator interface (required only if running viero-telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# PostgreSQL is optional; omit DATABASE_URL to use atomic file persistence.
DATABASE_URL=
TEST_DATABASE_URL=

# Optional post-close residual normalization through Relay.
# Relay is not required for discovery, opening, or closing liquidity.
RELAY_API_KEY=

# Add these only when enabling additional chains.
VIERO_RPC_56=
VIERO_RPC_8453=
VIERO_RPC_5042=

# ── 4. OPTIONAL LLM ────────────────────────────────────────────────────
# Deterministic Viero operation does not require an LLM.
VIERO_LLM_ENABLED=false
VIERO_LLM_BASE_URL=
VIERO_LLM_API_KEY=
VIERO_LLM_MODEL=
VIERO_LLM_MODEL_SCREENER=
VIERO_LLM_MODEL_MANAGER=
VIERO_LLM_MODEL_GENERAL=
VIERO_LLM_TEMPERATURE=0.2
VIERO_LLM_MAX_TOKENS=1024
VIERO_LLM_TIMEOUT_MS=90000

# ── 5. ADVANCED CONFIGURATION: existing defaults ───────────────────────
VIERO_GMGN_BIN=gmgn-cli
VIERO_CONFIG=config/viero.paper.json
VIERO_DATA_DIR=data/viero
VIERO_TOKEN_LIMIT=50
VIERO_POOL_LIMIT=10
VIERO_TOKEN_MEMORY_PATH=data/viero/token-memory.json
VIERO_BLOCKED_TOKENS_PATH=data/viero/blocked-tokens.json
VIERO_SIGNER_SOCKET=/run/viero-signer/viero.sock
VIERO_SIGNER_TX_JOURNAL=/var/lib/viero-signer/transactions.jsonl
VIERO_SKIP_GMGN_PREFLIGHT=0

# Legacy indexer settings are development-only. Production keeps the indexer
# service disabled and inactive; normal discovery and management do not need it.
VIERO_INDEXER_DISABLE=1
VIERO_INDEXER_HOST=127.0.0.1
VIERO_INDEXER_PORT=9100
VIERO_INDEXER_DATA_DIR=data/viero-indexer
VIERO_INDEXER_4663=
VIERO_INDEXER_56=
VIERO_INDEXER_8453=
VIERO_INDEXER_5042=
VIERO_INDEXER_START_4663=
VIERO_INDEXER_START_56=
VIERO_INDEXER_START_8453=
VIERO_INDEXER_START_5042=
